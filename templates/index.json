SECTION ================= *\/\n.reviews-section {\n  background: var(--bg);\n  padding: 70px 20px 50px;\n  font-family: \"Poppins\", sans-serif;\n  text-align: center;\n  border-radius: 32px;\n}\n\n\/* ================= HEADER ================= *\/\n.reviews-section h2 {\n  font-size: 3rem;\n  font-weight: 700;\n  margin-bottom: 8px;\n  color: var(--text);\ndisplay: inline-flex;\n  flex-wrap: wrap;\n  gap: 0.4em;\n}\n\nhtml[dir=\"rtl\"] .reviews-section h2 {\n  flex-direction: row-reverse;\n}\n\n\n.reviews-section h2 span {\n  color: var(--accent);\n}\n\n.reviews-section p.subtitle {\n  color: var(--muted);\n  font-size: 1rem;\n  margin-bottom: 45px;\n}\n\n\/* ================= SCROLL ================= *\/\n.reviews-scroll-wrapper {\n  position: relative;\n  max-width: 1150px;\n  margin: auto;\n}\n\n.reviews-scroll {\n  display: flex;\n  gap: 24px;\n  overflow-x: auto;\n  scroll-snap-type: x mandatory;\n  padding: 12px 6px;\n  scrollbar-width: none;\n}\n\n.reviews-scroll::-webkit-scrollbar {\n  display: none;\n}\n\n\/* ================= CARD ================= *\/\n.review-card {\n  flex: 0 0 auto;\n  background: var(--card-bg);\n  border-radius: 22px;\n  padding: 10px;\n  scroll-snap-align: center;\n  box-shadow: 0 10px 30px rgba(0,0,0,0.08);\n  transition: transform .35s ease, box-shadow .35s ease;\n}\n\n.review-card:hover {\n  transform: translateY(-6px);\n  box-shadow: 0 20px 45px rgba(0,0,0,0.15);\n}\n\n.review-card img {\n  width: 100%;\n  max-height: 480px;\n  object-fit: contain;\n  border-radius: 14px;\n}\n\n\/* ================= ARROWS ================= *\/\n.chevron {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 46px;\n  height: 46px;\n  border-radius: 50%;\n  background: rgba(0,0,0,.55);\n  color: var(--accent);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 22px;\n  cursor: pointer;\n  transition: .3s;\n  z-index: 5;\n}\n\n.chevron:hover {\n  background: var(--accent);\n  color: #000;\n}\n\n.chevron.left { left: -12px; }\n.chevron.right { right: -12px; }\n\n\/* ================= PROGRESS ================= *\/\n.progress-bar {\n  width: 100%;\n  height: 4px;\n  background: #e5e7eb;\n  border-radius: 6px;\n  margin-top: 22px;\n  overflow: hidden;\n}\n\n.progress-fill {\n  height: 100%;\n  background: linear-gradient(90deg, var(--accent), #b9e7fb);\n  width: 0%;\n  transition: width .25s ease;\n}\n\n\/* ================= MOBILE ================= *\/\n@media (max-width: 768px) {\n\n  .reviews-section {\n    padding: 55px 14px 60px;\n  }\n\n  .reviews-section h2 {\n    font-size: 2.2rem;\n  }\n\n  .reviews-section p.subtitle {\n    font-size: .95rem;\n    margin-bottom: 30px;\n  }\n\n  .reviews-scroll {\n    gap: 0;\n    padding: 0;\n  }\n\n  .review-card {\n    width: 100%;\n    margin: 0 10px;\n  }\n\n  .review-card img {\n    max-height: 340px;\n  }\n\n  .chevron {\n    display: none;\n  }\n}\n\nhtml[dir=\"rtl\"] .chevron.left {\n  right: -12px;\n  left: auto;\n}\n\nhtml[dir=\"rtl\"] .chevron.right {\n  left: -12px;\n  right: auto;\n}\n\n<\/style>\n\n<h2 id=\"reviews-heading\">\n  Our Clients’ <span>Feedback<\/span>\n<\/h2>\n\n<p class=\"subtitle\" id=\"reviews-subtitle\">\n  Real results and satisfaction — from people who trusted us.\n<\/p>\n\n<div class=\"reviews-scroll-wrapper\">\n  <div class=\"chevron left\" id=\"prev\">❮<\/div>\n  <div class=\"chevron right\" id=\"next\">❯<\/div>\n\n  <div class=\"reviews-scroll\" id=\"slider\">\n\n    <div class=\"review-card\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0847\/2120\/5545\/files\/IMG_2822.jpg?v=1765743215\">\n    <\/div>\n\n    <div class=\"review-card\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0847\/2120\/5545\/files\/IMG_2821.jpg?v=1765743214\">\n    <\/div>\n\n    <div class=\"review-card\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0847\/2120\/5545\/files\/IMG_2820.jpg?v=1765743215\">\n    <\/div>\n\n    <div class=\"review-card\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0847\/2120\/5545\/files\/IMG_2832.jpg?v=1765743214\">\n    <\/div>\n\n  <\/div>\n\n  <div class=\"progress-bar\">\n    <div class=\"progress-fill\" id=\"bar\"><\/div>\n  <\/div>\n<\/div>\n\n<script>\nconst slider = document.getElementById(\"slider\");\nconst bar = document.getElementById(\"bar\");\n\nconst isRTL = document.documentElement.dir === \"rtl\";\n\ndocument.getElementById(\"prev\").onclick = () => {\n  slider.scrollBy({\n    left: isRTL ? slider.offsetWidth : -slider.offsetWidth,\n    behavior: \"smooth\"\n  });\n};\n\ndocument.getElementById(\"next\").onclick = () => {\n  slider.scrollBy({\n    left: isRTL ? -slider.offsetWidth : slider.offsetWidth,\n    behavior: \"smooth\"\n  });\n};\n\nslider.addEventListener(\"scroll\", () => {\n  const max = slider.scrollWidth - slider.clientWidth;\n  const progress = Math.abs(slider.scrollLeft) \/ max;\n  bar.style.width = (progress * 100) + \"%\";\n});\n<\/script>\n\n<script>\n(function () {\n  const isRTL = document.documentElement.dir === \"rtl\" ||\n                document.documentElement.lang === \"ar\";\n\n  if (isRTL) {\n    document.getElementById(\"reviews-heading\").innerHTML =\n      \"آراء <span>عملائنا<\/span>\";\n\n    document.getElementById(\"reviews-subtitle\").innerText =\n      \"تجارب حقيقية من أهالٍ وثقوا بمنتجات WeeWonders.\";\n  }\n})();\n<\/script>\n\n\n<\/section>","full_width":true,"show_divider":false,"padding_top":0,"padding_bottom":0}},"scrolling_promotion_cEPayP":{"type":"scrolling-promotion","blocks":{"announcement_69zE6h":{"type":"announcement","settings":{"icon":"none","icon_size":"medium","custom_icon":"","text":"#1 destination for premium baby essentials","text_size":20,"link":""}},"announcement_GjpC9w":{"type":"announcement","settings":{"icon":"none","icon_size":"medium","custom_icon":"","text":"Fast &amp; Free delivery, and trusted quality for your little ones.","text_size":20,"link":""}},"announcement_KYPRGg":{"type":"announceme