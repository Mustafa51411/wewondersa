# WeeWonders Meta Conversions API (CAPI) & Webhook Tracking Configuration

# 1. Meta Pixel & Conversions API Credentials
META_PIXEL_ID=1032874294681740
# The secret system user access token sent by PNCL (DO NOT COMMIT THIS TO GIT)
META_CAPI_ACCESS_TOKEN=your_meta_system_user_access_token_here

# 2. Meta Test Events (Optional - for debugging in Meta Events Manager > Test Events)
# TEST_EVENT_CODE=TEST12345

# 3. Shopify Webhook Secrets (From Shopify Admin > Settings > Notifications > Webhooks)
# Used to verify the HMAC signature of order webhooks
SHOPIFY_WEBHOOK_SECRET_SA=your_sa_webhook_secret_here
SHOPIFY_WEBHOOK_SECRET_LB=your_lb_webhook_secret_here

# 4. Optional: Redis / Upstash / Vercel KV for persistent WhatsApp Reference Code storage
# KV_REST_API_URL=https://your-kv.upstash.io
# KV_REST_API_TOKEN=your_kv_token

# 5. Server Port (for standalone Node.js deployment)
PORT=3000
