{% comment %}
  WeeWonders Universal Attribution & WhatsApp Tracking Snippet (Saudi Arabia)
  - Captures and preserves fbc, fbp, and UTMs into Shopify Cart Attributes (SOW Task 3)
  - Generates WhatsApp reference codes and links attribution to draft orders (SOW Task 5)
{% endcomment %}
<script>
(function() {
  'use strict';

  var STORE = 'sa';
  // Keep this URL explicit. It must be the same deployed tracking host as the custom pixel.
  var TRACKING_SERVER_URL = 'https://wewondersa-tracking.vercel.app';

  function getCookie(name) {
    var match = document.cookie.match(new RegExp('(^|;\\s*)(' + name + ')=([^;]*)'));
    return match ? decodeURIComponent(match[3]) : null;
  }

  function setCookie(name, value, days) {
    var expires = '';
    if (days) {
      var d = new Date();
      d.setTime(d.getTime() + (days * 24 * 60 * 60 * 1000));
      expires = '; expires=' + d.toUTCString();
    }
    var domain = window.location.hostname.includes('.') ? '; domain=.' + window.location.hostname.replace(/^www\./, '') : '';
    document.cookie = name + '=' + encodeURIComponent(value) + expires + '; path=/' + domain + '; SameSite=Lax';
  }

  // 1. Capture UTMs & Click IDs
  var urlParams = new URLSearchParams(window.location.search);
  var fbclid = urlParams.get('fbclid');
  var fbc = getCookie('_fbc');
  var fbp = getCookie('_fbp');

  if (!fbc && fbclid) {
    fbc = 'fb.1.' + Date.now() + '.' + fbclid;
    setCookie('_fbc', fbc, 90);
  }

  var utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
  var utms = {};

  utmKeys.forEach(function(k) {
    var val = urlParams.get(k);
    if (val) {
      utms[k] = val;
      try { sessionStorage.setItem('ww_' + k, val); } catch (_) {}
    } else {
      try {
        var saved = sessionStorage.getItem('ww_' + k);
        if (saved) utms[k] = saved;
      } catch (_) {}
    }
  });

  // 2. Persist fbc, fbp & UTMs into Shopify Cart Attributes
  function syncCartAttributes() {
    var cartAttrs = {};
    if (fbc) cartAttrs['_fbc'] = fbc;
    if (fbp) cartAttrs['_fbp'] = fbp;
    Object.keys(utms).forEach(function(k) {
      if (utms[k]) cartAttrs[k] = utms[k];
    });

    if (Object.keys(cartAttrs).length > 0) {
      try {
        fetch('/cart/update.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ attributes: cartAttrs })
        }).catch(function() {});
      } catch (_) {}
    }
  }

  if (document.readyState === 'complete') {
    setTimeout(syncCartAttributes, 500);
  } else {
    window.addEventListener('load', function() {
      setTimeout(syncCartAttributes, 500);
    });
  }

  // 3. WhatsApp Reference Code Generator & Click Tracking
  function generateRefCode() {
    var chars = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';
    var code = 'W';
    for (var i = 0; i < 4; i++) {
      code += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return code;
  }

  function cartData() {
    return fetch('/cart.js', { credentials: 'same-origin' }).then(function(response) { return response.ok ? response.json() : {}; }).then(function(cart) {
      var items = Array.isArray(cart.items) ? cart.items : [];
      var contents = items.map(function(item) { return { id: String(item.product_id || item.variant_id || ''), quantity: Number(item.quantity || 1), item_price: Number(item.final_price || item.price || 0) / 100 }; }).filter(function(item) { return item.id; });
      return { value: Number(cart.total_price || 0) / 100, currency: cart.currency || 'SAR', num_items: items.reduce(function(total, item) { return total + Number(item.quantity || 0); }, 0), content_ids: contents.map(function(item) { return item.id; }), contents: contents };
    }).catch(function() { return { value: 0, currency: 'SAR', num_items: 0, content_ids: [], contents: [] }; });
  }

  function whatsappUrl(link, ref) {
    var href = link.getAttribute('href') || '';
    var refTag = ' [Ref: ' + ref + ']';
    if (href.indexOf('text=') >= 0) return href.replace(/([?&]text=)([^&]*)/, function(_, prefix, text) { return prefix + text + encodeURIComponent(refTag); });
    return href + (href.indexOf('?') >= 0 ? '&' : '?') + 'text=' + encodeURIComponent('Hi WeeWonders' + refTag);
  }

  function publishWhatsApp(ref, ts, cart) {
    if (window.Shopify && Shopify.analytics && typeof Shopify.analytics.publish === 'function') Shopify.analytics.publish('ww_whatsapp', { ref: ref, ts: ts, value: cart.value, currency: cart.currency, content_ids: cart.content_ids, num_items: cart.num_items });
  }

  function storeClick(ref, ts, cart) {
    return fetch(TRACKING_SERVER_URL.replace(/\/+$/, '') + '/api/wa-click', { method: 'POST', headers: { 'Content-Type': 'application/json' }, keepalive: true, body: JSON.stringify({ ref: ref, ts: ts, fbc: fbc, fbp: fbp, attribution: utms, fbclid: fbclid, ad_id: urlParams.get('ad_id'), cart: cart, store: STORE, page_url: window.location.href }) });
  }

  function handleWhatsAppClick(e) {
    var link = e.target.closest('a[href*="wa.me"], a[href*="whatsapp.com"], [data-whatsapp-btn], .wwsa-btn--whatsapp');
    if (!link) return;

    if (link.dataset.wwTrackingPending === 'true') return;
    e.preventDefault();
    link.dataset.wwTrackingPending = 'true';
    var persistentRef = generateRefCode();
    var persistentTs = Date.now();
    var persistentHref = whatsappUrl(link, persistentRef);
    cartData().then(function(cart) {
      publishWhatsApp(persistentRef, persistentTs, cart);
      return Promise.allSettled([
        fetch('/cart/update.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ attributes: { wa_ref: persistentRef } }), keepalive: true }).catch(function() {}),
        storeClick(persistentRef, persistentTs, cart)
      ]);
    }).finally(function() {
      if (link.target === '_blank') {
        var popup = window.open(persistentHref, '_blank', 'noopener');
        if (popup) return;
      }
      window.location.assign(persistentHref);
    });
    return;

    var refCode = generateRefCode();
    var waEventId = 'wa_' + refCode + '_' + Date.now();

    // Attach reference code to WhatsApp URL with Arabic prefix
    var href = link.getAttribute('href') || '';
    if (href) {
      var refTag = ' [رمز: ' + refCode + ']';
      if (href.includes('text=')) {
        href = href.replace(/([?&]text=)([^&]*)/, function(match, p1, p2) {
          return p1 + p2 + encodeURIComponent(refTag);
        });
      } else {
        var sep = href.includes('?') ? '&' : '?';
        href = href + sep + 'text=' + encodeURIComponent('مرحباً، أريد طلب مضخة WeeWonders' + refTag);
      }
      link.setAttribute('href', href);
    }

    // Save wa_ref attribute in cart
    try {
      fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ attributes: { 'wa_ref': refCode } })
      }).catch(function() {});
    } catch (_) {}

  }

  document.addEventListener('click', handleWhatsAppClick, true);
})();
</script>
