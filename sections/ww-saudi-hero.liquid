{{ 'ww-saudi-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  if product.selected_variant == blank
    for candidate_variant in product.variants
      assign candidate_title = candidate_variant.title | downcase
      if candidate_title contains 'double' or candidate_variant.title contains 'مزدوج'
        assign current_variant = candidate_variant
        break
      endif
    endfor
  endif
  assign form_id = 'wwsa-product-form-' | append: section.id
  assign fallback_gallery = 'ww-sa-img-02.jpg,ww-sa-img-04.jpg,ww-sa-img-05.jpg,ww-sa-img-06.jpg,ww-sa-img-07.jpg,ww-sa-img-08.jpg' | split: ','
-%}

<section class="wwsa wwsa-hero" dir="rtl" data-section-id="{{ section.id }}">
  <div class="wwsa-wrap wwsa-hero__grid">
    <div class="wwsa-gallery">
      <div class="wwsa-gallery__main">
        {%- assign primary_media = product.featured_media.preview_image | default: product.featured_image -%}
        {%- if primary_media != blank -%}
          {%- assign primary_image_id = 'wwsa-main-' | append: section.id -%}
          {{ primary_media | image_url: width: 1400 | image_tag: id: primary_image_id, loading: 'eager', widths: '480,720,960,1200,1400', sizes: '(min-width: 900px) 50vw, 100vw', alt: product.title }}
        {%- else -%}
          <img id="wwsa-main-{{ section.id }}" src="{{ 'ww-sa-img-02.jpg' | asset_url }}" alt="{{ product.title | escape }}" width="1200" height="1200" loading="eager">
        {%- endif -%}
        <button class="wwsa-gallery__nav wwsa-gallery__nav--prev" type="button" aria-label="الصورة السابقة">‹</button>
        <button class="wwsa-gallery__nav wwsa-gallery__nav--next" type="button" aria-label="الصورة التالية">›</button>
      </div>
      <div class="wwsa-gallery__thumbs" aria-label="صور المنتج">
        {%- assign gallery_count = 0 -%}
        {%- for media in product.media limit: 6 -%}
          {%- assign gallery_count = gallery_count | plus: 1 -%}
          <button class="wwsa-gallery__thumb{% if forloop.first %} is-active{% endif %}" type="button" data-image="{{ media.preview_image | image_url: width: 1400 }}" aria-label="عرض الصورة {{ forloop.index }}">
            {{ media.preview_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
          </button>
        {%- endfor -%}
        {%- if gallery_count == 0 -%}
          {%- for fallback in fallback_gallery -%}
            <button class="wwsa-gallery__thumb{% if forloop.first %} is-active{% endif %}" type="button" data-image="{{ fallback | asset_url }}" aria-label="عرض الصورة {{ forloop.index }}">
              <img src="{{ fallback | asset_url }}" alt="{{ product.title | escape }}" width="220" height="220" loading="lazy">
            </button>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="wwsa-hero__content" id="wwsa-buy">
      <div class="wwsa-rating"><span class="wwsa-rating__stars">★★★★★ {{ section.settings.rating }}</span><span class="wwsa-rating__proof">{{ section.settings.social_proof }}</span></div>
      <h1>{{ section.settings.heading_prefix }} <mark>{{ section.settings.heading_highlight }}</mark> {{ section.settings.heading_suffix | default: product.title }}</h1>
      <p class="wwsa-hero__promise">{{ section.settings.promise }}</p>
      <div class="wwsa-features">
        {%- for i in (1..4) -%}
          {%- assign key = 'feature_' | append: i -%}
          {%- assign text = section.settings[key] -%}
          {%- if text != blank -%}<div><span class="wwsa-feature-icon">✓</span><strong>{{ text }}</strong></div>{%- endif -%}
        {%- endfor -%}
      </div>
      <div class="wwsa-specs">
        <div><strong>{{ section.settings.spec_1_value }}</strong><span>{{ section.settings.spec_1_label }}</span></div>
        <div><strong>{{ section.settings.spec_2_value }}</strong><span>{{ section.settings.spec_2_label }}</span></div>
        <div><strong>{{ section.settings.spec_3_value }}</strong><span>{{ section.settings.spec_3_label }}</span></div>
      </div>

      {% form 'product', product, id: form_id, class: 'wwsa-product-form' %}
        <div class="wwsa-variants" role="radiogroup" aria-label="{{ section.settings.variant_label | escape }}">
          {%- assign single_variant_price = product.variants.first.price -%}
          {%- for possible_variant in product.variants -%}
            {%- assign possible_variant_title = possible_variant.title | downcase -%}
            {%- unless possible_variant_title contains 'double' or possible_variant.title contains 'مزدوج' -%}
              {%- assign single_variant_price = possible_variant.price -%}
              {%- break -%}
            {%- endunless -%}
          {%- endfor -%}
          {%- for variant in product.variants -%}
            {%- assign variant_image = variant.featured_image | default: product.featured_image -%}
            {%- assign offer_type = 'single' -%}
            {%- assign variant_title_downcase = variant.title | downcase -%}
            {%- if variant_title_downcase contains 'double' or variant.title contains 'مزدوج' -%}{%- assign offer_type = 'double' -%}{%- endif -%}
            {%- assign display_variant_title = variant.title -%}
            {%- if offer_type == 'double' and section.settings.double_offer_title != blank -%}
              {%- assign display_variant_title = section.settings.double_offer_title -%}
            {%- elsif offer_type == 'single' and section.settings.single_offer_title != blank -%}
              {%- assign display_variant_title = section.settings.single_offer_title -%}
            {%- endif -%}
            <label class="wwsa-variant wwsa-variant--{{ offer_type }}{% if variant.id == current_variant.id %} is-selected{% endif %}{% unless variant.available %} is-soldout{% endunless %}" data-variant-card data-offer-type="{{ offer_type }}" data-variant-id="{{ variant.id }}" data-variant-price="{{ variant.price }}" data-variant-title="{{ display_variant_title | escape }}"{% if variant_image != blank %} data-variant-image="{{ variant_image | image_url: width: 1400 }}"{% endif %}>
              <input id="wwsa-variant-{{ section.id }}-{{ variant.id }}" type="radio" name="id" value="{{ variant.id }}"{% if variant.id == current_variant.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
              {%- if variant_image != blank -%}{{ variant_image | image_url: width: 240 | image_tag: class: 'wwsa-variant__image', loading: 'lazy', alt: variant.title }}{%- endif -%}
              <div class="wwsa-variant__body">
                <strong class="wwsa-variant__title">{{ display_variant_title }}</strong>
                <div class="wwsa-variant__perks">
                  {%- if section.settings.variant_perk_1 != blank -%}<span>{{ section.settings.variant_perk_1 }}</span>{%- endif -%}
                  {%- if section.settings.variant_perk_2 != blank -%}<span>{{ section.settings.variant_perk_2 }}</span>{%- endif -%}
                </div>
              </div>
              <div class="wwsa-variant__price-wrap"><span class="wwsa-variant__price">{{ variant.price | money }}</span>{% if variant.compare_at_price > variant.price %}<s class="wwsa-variant__compare">{{ variant.compare_at_price | money }}</s><span class="wwsa-variant__save">{{ 'وفر ' }}{{ variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price }}%</span>{% endif %}</div>
              {%- if offer_type == 'double' and product.variants.size > 1 -%}
                {%- assign two_single_price = single_variant_price | times: 2 -%}
                {%- assign bundle_saving = two_single_price | minus: variant.price -%}
                {%- if bundle_saving > 0 -%}<span class="wwsa-variant__bundle-save">{{ section.settings.bundle_saving_prefix }} {{ bundle_saving | money }} {{ section.settings.bundle_saving_suffix }}</span>{%- endif -%}
              {%- endif -%}
              <div class="wwsa-variant__gifts" aria-label="{{ section.settings.included_gifts_label | escape }}">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'gift' -%}
                    {%- if block.settings.applies_to == offer_type or block.settings.applies_to == 'both' -%}
                    <div class="wwsa-gift" {{ block.shopify_attributes }}>
                      <span class="wwsa-gift__plus" aria-hidden="true">+</span>
                      {%- assign gift_label = block.settings.title | default: block.settings.product.title -%}
                      {%- assign gift_label_downcase = gift_label | downcase -%}
                      {%- assign default_gift_asset = blank -%}
                      {%- if gift_label_downcase contains 'مسخن' or gift_label_downcase contains 'warmer' -%}
                        {%- assign default_gift_asset = 'ww-sa-img-10.jpg' -%}
                      {%- elsif gift_label_downcase contains 'وسادة' or gift_label_downcase contains 'pillow' -%}
                        {%- assign default_gift_asset = 'ww-sa-img-13.jpg' -%}
                      {%- elsif gift_label_downcase contains 'أكياس' or gift_label_downcase contains 'bags' -%}
                        {%- assign default_gift_asset = 'ww-sa-img-11.jpg' -%}
                      {%- endif -%}
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: gift_label }}
                      {%- elsif block.settings.product != blank and block.settings.product.featured_image != blank -%}
                        {{ block.settings.product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: gift_label }}
                      {%- elsif default_gift_asset != blank -%}
                        <img src="{{ default_gift_asset | asset_url }}" width="120" height="120" loading="lazy" alt="{{ gift_label | escape }}">
                      {%- endif -%}
                      <span><strong>{{ gift_label }}</strong><small>{{ block.settings.price_text }}</small></span>
                    </div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </label>
          {%- endfor -%}
        </div>

        <p class="wwsa-offer-note">🎁 {{ section.settings.offer_note }}</p>
        <button class="wwsa-btn wwsa-btn--primary" type="submit" name="add"{% unless current_variant.available %} disabled{% endunless %}>{{ section.settings.add_to_cart_label }}</button>
        {%- if section.settings.whatsapp_number != blank -%}
          <a class="wwsa-btn wwsa-btn--whatsapp" data-whatsapp-btn target="_blank" rel="noopener" href="https://wa.me/{{ section.settings.whatsapp_number | remove: ' ' | remove: '+' }}?text={{ section.settings.whatsapp_message | url_encode }}">{{ section.settings.whatsapp_label }}</a>
        {%- endif -%}
      {% endform %}

      <div class="wwsa-guarantee-box"><strong>{{ section.settings.guarantee_title }}</strong><span>{{ section.settings.guarantee_text }}</span></div>
    </div>
  </div>
</section>

<div class="wwsa wwsa-sticky" data-wwsa-sticky>
  <div class="wwsa-sticky__inner"><div class="wwsa-sticky__price"><strong data-sticky-price>{{ current_variant.price | money }}</strong><small data-sticky-title>{{ current_variant.title }}</small></div>
  <button class="wwsa-btn wwsa-btn--primary" type="button" data-submit-form="{{ form_id }}">{{ section.settings.sticky_label }}</button></div>
</div>

<script>
(() => {
  const root = document.querySelector('[data-section-id="{{ section.id }}"]');
  if (!root || root.dataset.ready) return; root.dataset.ready = 'true';
  const main = root.querySelector('#wwsa-main-{{ section.id }}');
  const thumbs = [...root.querySelectorAll('.wwsa-gallery__thumb')];
  let active = 0;
  function show(i){ if(!thumbs.length || !main) return; active=(i+thumbs.length)%thumbs.length; main.src=thumbs[active].dataset.image; thumbs.forEach((t,n)=>t.classList.toggle('is-active',n===active)); }
  thumbs.forEach((t,i)=>t.addEventListener('click',()=>show(i)));
  root.querySelector('.wwsa-gallery__nav--prev')?.addEventListener('click',()=>show(active-1));
  root.querySelector('.wwsa-gallery__nav--next')?.addEventListener('click',()=>show(active+1));
  const form = root.querySelector('.wwsa-product-form');
  // Shopify's automatic Buy X Get Y discount makes this variant free only
  // alongside the double pump. The theme adds it once so the customer does
  // not have to discover the gift product or add it manually.
  const DOUBLE_PUMP_GIFT_VARIANT_ID = 51931312226596;

  // Cart addition is handled by Shopify's AJAX endpoint. Analytics is subscribed
  // through Shopify Customer Events / the server-side CAPI endpoint, not theme JS.
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const selected = root.querySelector('[data-variant-card] input[name="id"]:checked')?.closest('[data-variant-card]');
    const variantInput = form.querySelector('input[name="id"]:checked') || form.querySelector('input[name="id"]');
    const variantId = selected?.dataset.variantId || variantInput?.value;
    const isDoubleOffer = selected?.dataset.offerType === 'double';
    if (!variantId) {
      form.submit();
      return;
    }
    const submitBtn = form.querySelector('[type="submit"]');
    const stickyBtn = document.querySelector('[data-submit-form="{{ form_id }}"]');
    if (submitBtn) { submitBtn.disabled = true; submitBtn.style.opacity = '0.75'; }
    if (stickyBtn) { stickyBtn.disabled = true; stickyBtn.style.opacity = '0.75'; }

    // Cart addition and drawer support. Some published versions of this theme
    // render the <mini-cart> markup without the component API, so never call
    // its methods unless both are actually available.
    const miniCart = document.querySelector('mini-cart');
    const canRenderMiniCart = Boolean(
      miniCart &&
      typeof miniCart.getSectionsToRender === 'function' &&
      typeof miniCart.renderContents === 'function'
    );
    const sections = canRenderMiniCart ? miniCart.getSectionsToRender().map((s) => s.id) : [];

    const requestBody = {
      id: Number(variantId),
      quantity: 1
    };
    if (sections.length) {
      requestBody.sections = sections;
      requestBody.sections_url = window.location.pathname;
    }

    // Use the product form action so Shopify keeps the active /ar-sa locale.
    const cartAddUrl = form.action.replace(/\/add(?:\.js)?(?:\?.*)?$/, '/add.js');
    const cartUrl = form.action.replace(/\/add(?:\.js)?(?:\?.*)?$/, '');
    fetch(cartAddUrl, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify(requestBody)
    })
    .then((res) => {
      if (!res.ok) throw new Error('Add to cart failed');
      return res.json();
    })
    .then(async (response) => {
      if (response.status && response.status >= 400) {
        throw new Error(response.description || 'Add to cart error');
      }

      let cartResponse = response;
      if (isDoubleOffer) {
        // Keep a single warmer in the cart. The automatic discount itself is
        // limited to one gift per order, so adding extras would be misleading.
        try {
          const cart = await fetch(`${cartUrl}.js`, {
            headers: { 'Accept': 'application/json' }
          }).then((res) => res.ok ? res.json() : null);
          const hasGift = cart?.items?.some((item) => Number(item.variant_id) === DOUBLE_PUMP_GIFT_VARIANT_ID);

          if (!hasGift) {
            const giftRequestBody = {
              id: DOUBLE_PUMP_GIFT_VARIANT_ID,
              quantity: 1,
              properties: { '_ww_offer': 'Free bottle warmer with double pump' }
            };
            if (sections.length) {
              giftRequestBody.sections = sections;
              giftRequestBody.sections_url = window.location.pathname;
            }
            const giftResponse = await fetch(cartAddUrl, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
              },
              body: JSON.stringify(giftRequestBody)
            });
            if (!giftResponse.ok) throw new Error('Unable to add the free bottle warmer');
            cartResponse = await giftResponse.json();
          }
        } catch (giftError) {
          // Do not block the pump purchase if Shopify temporarily rejects the
          // separate gift line; retain a clear diagnostic for support.
          console.warn('[Double pump gift]', giftError);
        }
      }

      if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
        publish(PUB_SUB_EVENTS.cartUpdate, { source: 'wwsa-product-form', productVariantId: variantId });
      }

      document.dispatchEvent(new CustomEvent('ajaxProduct:added', {
        detail: { product: response }
      }));

      if (canRenderMiniCart) {
        miniCart.renderContents(cartResponse);
      } else {
        // The cart was added successfully; open the locale-aware full cart
        // instead of trying to use a drawer API this theme does not expose.
        window.location.assign(cartUrl);
      }
    })
    .catch((err) => {
      console.warn('[Add to cart] AJAX failed, falling back to form submit:', err);
      form.submit();
    })
    .finally(() => {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.style.opacity = '1'; }
      if (stickyBtn) { stickyBtn.disabled = false; stickyBtn.style.opacity = '1'; }
    });
  });

  const selectVariant = (card, notify = true) => {
    const input = card.querySelector('input[name="id"]');
    if (!input || input.disabled) return;
    root.querySelectorAll('[data-variant-card]').forEach((item) => {
      const itemInput = item.querySelector('input[name="id"]');
      item.classList.toggle('is-selected', item === card);
      if (itemInput) itemInput.checked = item === card;
    });
    if (main && card.dataset.variantImage) {
      main.src = card.dataset.variantImage;
      thumbs.forEach((thumb) => thumb.classList.remove('is-active'));
    }
    root.querySelector('[data-sticky-price]')?.replaceChildren(document.createTextNode(card.querySelector('.wwsa-variant__price')?.textContent || ''));
    root.querySelector('[data-sticky-title]')?.replaceChildren(document.createTextNode(card.querySelector('.wwsa-variant__title')?.textContent || ''));
    // Notify Shopify's native product-form listeners from the actual variant
    // input. This keeps selected offer, cart submission, and web-pixel events
    // in sync instead of only changing the card visually.
    if (notify) input.dispatchEvent(new Event('change', { bubbles: true }));
  };

  root.querySelectorAll('[data-variant-card]').forEach((card) => {
    card.addEventListener('click', (event) => { event.preventDefault(); selectVariant(card); });
    card.querySelector('input[name="id"]')?.addEventListener('change', () => selectVariant(card, false));
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); selectVariant(card); }
    });
    card.setAttribute('tabindex', card.querySelector('input:not(:disabled)') ? '0' : '-1');
  });

  // Sticky Bar Trigger
  const stickyTrigger = document.querySelector('[data-submit-form="{{ form_id }}"]');
  if (stickyTrigger) {
    stickyTrigger.addEventListener('click', () => {
      const formEl = document.getElementById('{{ form_id }}');
      if (!formEl) return;
      if (typeof formEl.requestSubmit === 'function') {
        formEl.requestSubmit();
      } else {
        formEl.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
      }
    });
  }
})();
</script>

{% schema %}
{
  "name": "WW Saudi — Product hero",
  "tag": "section",
  "class": "wwsa-section-host",
  "settings": [
    {"type":"header","content":"Hero copy"},
    {"type":"text","id":"rating","label":"Rating","default":"4.8/5"},
    {"type":"text","id":"social_proof","label":"Social proof","default":"محبوبة من آلاف الأمهات في السعودية"},
    {"type":"text","id":"heading_prefix","label":"Heading prefix","default":"حليب أكثر"},
    {"type":"text","id":"heading_highlight","label":"Highlighted text","default":"خلال أسبوع"},
    {"type":"text","id":"heading_suffix","label":"Heading suffix","default":"مع مضخة WeeWonders"},
    {"type":"textarea","id":"promise","label":"Supporting copy","default":"بدون ألم، بدون ساعات ضخ طويلة، وبدون إعدادات معقدة."},
    {"type":"text","id":"feature_1","label":"Feature 1","default":"4 مقاسات + أداة تساعدك تختارين المناسب"},
    {"type":"text","id":"feature_2","label":"Feature 2","default":"تفرغ الحليب بالكامل لتدعم الإدرار"},
    {"type":"text","id":"feature_3","label":"Feature 3","default":"ألم أقل من أول يوم"},
    {"type":"text","id":"feature_4","label":"Feature 4","default":"بدون يدين، هادئة ولا تسرب"},
    {"type":"header","content":"Specs and offer"},
    {"type":"text","id":"spec_1_value","label":"Spec 1 value","default":"5–6"},{"type":"text","id":"spec_1_label","label":"Spec 1 label","default":"جلسات لكل شحنة"},
    {"type":"text","id":"spec_2_value","label":"Spec 2 value","default":"180 مل"},{"type":"text","id":"spec_2_label","label":"Spec 2 label","default":"كوب مانع للتسرب"},
    {"type":"text","id":"spec_3_value","label":"Spec 3 value","default":"4 أوضاع"},{"type":"text","id":"spec_3_label","label":"Spec 3 label","default":"12 مستوى لكل وضع"},
    {"type":"text","id":"variant_label","label":"Variant group label","default":"اختاري مجموعتك"},
    {"type":"text","id":"double_offer_title","label":"Double offer display title","default":"مضخة مزدوجة"},
    {"type":"text","id":"single_offer_title","label":"Single offer display title","default":"مضخة مفردة"},
    {"type":"text","id":"variant_perk_1","label":"Variant perk 1","default":"عدة المقاسات مجاناً"},
    {"type":"text","id":"variant_perk_2","label":"Variant perk 2","default":"شحن مجاني"},
    {"type":"text","id":"popular_badge","label":"Popular badge","default":"الأكثر طلباً"},
    {"type":"text","id":"offer_note","label":"Offer note","default":"عدة المقاسات مجانية في كل علبة"},
    {"type":"text","id":"add_to_cart_label","label":"Add to cart label","default":"جربيها الآن بدون مخاطرة"},
    {"type":"text","id":"bundle_saving_prefix","label":"Double bundle saving prefix","default":"وفّري"},
    {"type":"text","id":"bundle_saving_suffix","label":"Double bundle saving suffix","default":"عن شراء مضختين مفردتين"},
    {"type":"text","id":"included_gifts_label","label":"Included gifts label","default":"الهدايا المجانية"},
    {"type":"header","content":"WhatsApp"},
    {"type":"text","id":"whatsapp_number","label":"WhatsApp number (country code, no +)"},
    {"type":"text","id":"whatsapp_label","label":"WhatsApp button label","default":"اطلبي عبر واتساب"},
    {"type":"textarea","id":"whatsapp_message","label":"WhatsApp prefilled message","default":"مرحباً، أريد طلب مضخة WeeWonders"},
    {"type":"header","content":"Guarantee"},
    {"type":"text","id":"guarantee_title","label":"Guarantee title","default":"ضمان 6 أشهر"},
    {"type":"text","id":"guarantee_text","label":"Guarantee text","default":"إذا توقفت عن العمل أو حصل أي عطل، نحن معك."},
    {"type":"text","id":"sticky_label","label":"Sticky CTA label","default":"جربيها الآن بدون مخاطرة"}
  ],
  "blocks": [
    {"type":"gift","name":"Included gift","settings":[{"type":"select","id":"applies_to","label":"Show with offer","default":"both","options":[{"value":"double","label":"Double pump only"},{"value":"single","label":"Single pump only"},{"value":"both","label":"Both offers"},{"value":"none","label":"Hidden"}]},{"type":"product","id":"product","label":"Gift product"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"text","id":"title","label":"Label"},{"type":"text","id":"price_text","label":"Price text","default":"مجاناً"}]}
  ],
  "max_blocks": 6,
  "presets": [{"name":"WW Saudi — Product hero","blocks":[{"type":"gift"},{"type":"gift"},{"type":"gift"},{"type":"gift"}]}]
}
{% endschema %}
