        <div class="ocard" role="radio" aria-checked="false" tabindex="0" data-name="مضخة مفردة" data-price="{{ sgl_price }} ر.س" data-variant-id="{{ sgl.id }}" onclick="pickO(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();pickO(this)}">
          
          <div class="ohead">
            <span class="oradio"></span>
            <img class="oimg" width="76" height="76" loading="eager" src="{{ 'ww-sa-img-06.png' | asset_url }}" alt="مضخة مفردة">
            <div class="otitle"><span class="oname">مضخة مفردة</span></div>
            <div class="oprice"><span class="onow">{{ sgl_price }} ر.س</span></div>
          </div>
          <ul class="ogifts"><li><span class="oc"><img src="{{ 'ww-sa-img-03.jpg' | asset_url }}" alt=""></span><span class="ot">+ عدة المقاسات مجاناً<small>4 مقاسات + أداة تساعدك تختارين مقاسك</small></span><span class="ov free">مجاناً</span></li><li><span class="oc"><img src="{{ 'ww-sa-img-04.webp' | asset_url }}" alt=""></span><span class="ot">+ أكياس حفظ الحليب (50 كيس) مجاناً</span><s class="ov">60 ر.س</s></li><li><span class="oc pad"><img src="{{ 'ww-sa-img-05.png' | asset_url }}" alt=""></span><span class="ot">+ شحن مجاني</span><span class="ov free">مجاناً</span></li></ul>
        </div>
      </div>
      <button class="btn btn-atc btn-lg" id="atc" type="button" onclick="addToCart(this)"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 016 0v2"/></svg><span>أضيفي للسلة</span><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6"/></svg></button>
      <a class="btn btn-whatsapp btn-lg" href="https://api.whatsapp.com/send/?phone={{ section.settings.whatsapp_number }}&text=%D9%87%D9%84%D8%A7%D8%8C%20%D8%A3%D8%A8%D9%8A%20%D8%A3%D8%B7%D9%84%D8%A8%20%D9%85%D8%B6%D8%AE%D8%A9%20WeeWonders" target="_blank" rel="noopener"><svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>اطلبي عبر واتساب</a>
      <div class="payrow" hidden aria-label="طرق الدفع"><span>مدى</span><span>Apple Pay</span><span>Tabby</span><span>Tamara</span><span>الدفع عند الاستلام</span></div>
      <div class="trust">
        <div class="t"><div class="i"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="14" height="10" rx="3"/><path d="M21 10v4"/></svg></div>توصيل سريع</div>
