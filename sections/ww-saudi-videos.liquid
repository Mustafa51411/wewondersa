{{ 'ww-saudi-pdp.css' | asset_url | stylesheet_tag }}
<section class="wwsa wwsa-section wwsa-videos" dir="rtl" id="wwsa-videos-{{ section.id }}">
  <div class="wwsa-wrap">
    <h2>{{ section.settings.heading_prefix }} <mark>{{ section.settings.heading_highlight }}</mark></h2>
    <p class="wwsa-section__lead">{{ section.settings.lead }}</p>
    <div class="wwsa-video-track">
      {%- for block in section.blocks -%}
        {%- assign poster_name = 'ww-sa-video-poster-0' | append: forloop.index | append: '.jpg' -%}
        <article class="wwsa-video-card" {{ block.shopify_attributes }}>
          <div class="wwsa-video-card__media">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: image_size: '700x', controls: false, muted: false, preload: 'metadata', playsinline: true }}
            {%- elsif block.settings.cover_image != blank -%}
              {{ block.settings.cover_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '360, 540, 700', alt: block.settings.name }}
            {%- else -%}
              <img src="{{ poster_name | asset_url }}" alt="{{ block.settings.name | escape }}" width="540" height="760" loading="lazy">
            {%- endif -%}
            {%- if block.settings.video != blank -%}
              <button class="wwsa-video-card__play" type="button" aria-label="تشغيل فيديو {{ block.settings.name | escape }}" aria-pressed="false"><span aria-hidden="true">▶</span></button>
            {%- endif -%}
          </div>
          <div class="wwsa-video-card__caption"><span>{{ block.settings.label }}</span><strong>{{ block.settings.name }}</strong><small>{{ block.settings.rating }}</small></div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
<script>
(() => {
  const section = document.getElementById('wwsa-videos-{{ section.id }}');
  if (!section) return;
  section.querySelectorAll('.wwsa-video-card').forEach(card => {
    const video = card.querySelector('video');
    const button = card.querySelector('.wwsa-video-card__play');
    if (!video || !button) return;
    const toggle = () => {
      if (video.paused) video.play(); else video.pause();
    };
    button.addEventListener('click', event => { event.stopPropagation(); toggle(); });
    card.querySelector('.wwsa-video-card__media').addEventListener('click', event => {
      if (!event.target.closest('.wwsa-video-card__play')) toggle();
    });
    video.addEventListener('play', () => { card.classList.add('is-playing'); button.setAttribute('aria-pressed', 'true'); button.setAttribute('aria-label', 'إيقاف الفيديو مؤقتاً'); });
    video.addEventListener('pause', () => { card.classList.remove('is-playing'); button.setAttribute('aria-pressed', 'false'); button.setAttribute('aria-label', 'تشغيل الفيديو'); });
    video.addEventListener('ended', () => { card.classList.remove('is-playing'); button.setAttribute('aria-pressed', 'false'); });
  });
})();
</script>
{% schema %}
{
  "name":"WW Saudi — Video stories",
  "settings":[
    {"type":"text","id":"heading_prefix","label":"Heading","default":"اسمعي قصص"},
    {"type":"text","id":"heading_highlight","label":"Highlighted text","default":"أمهات WeeWonders"},
    {"type":"textarea","id":"lead","label":"Intro text","default":"قصص حقيقية من أمهات وطبيبات جربن المضخة."}
  ],
  "blocks":[{"type":"video","name":"Video story","settings":[{"type":"video","id":"video","label":"Shopify-hosted video"},{"type":"image_picker","id":"cover_image","label":"Video cover image (shown if no video is selected)"},{"type":"text","id":"label","label":"Story label","default":"تجربة حقيقية"},{"type":"text","id":"name","label":"Name","default":"أم من WeeWonders"},{"type":"text","id":"rating","label":"Rating","default":"★★★★★"}]}],
  "max_blocks":5,
  "presets":[{"name":"WW Saudi — Video stories","blocks":[{"type":"video","settings":{"name":"نورة"}},{"type":"video","settings":{"name":"د. فرح"}},{"type":"video","settings":{"name":"د. ثريا"}},{"type":"video","settings":{"name":"د. إيليت"}},{"type":"video","settings":{"name":"جنى"}}]}]
}
{% endschema %}
