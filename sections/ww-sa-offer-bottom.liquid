<link rel="stylesheet" href="{{ 'ww-sa-pdp.css' | asset_url }}">
<style>@font-face{font-family:'Cairo';font-style:normal;font-weight:200 1000;font-display:swap;src:url({{ 'ww-sa-cairo-ar.woff2' | asset_url }}) format('woff2');unicode-range:U+0600-06FF,U+0750-077F,U+0870-088E,U+0890-0891,U+0898-08E1,U+08E3-08FF,U+200C-200E,U+2010-2011,U+204F,U+2E41,U+FB50-FDFF,U+FE70-FE74,U+FE76-FEFC}@font-face{font-family:'Cairo';font-style:normal;font-weight:200 1000;font-display:swap;src:url({{ 'ww-sa-cairo-lat.woff2' | asset_url }}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}</style>
<div class="ww-sa" dir="rtl" lang="ar">
{%- assign dbl = product.variants.first -%}{%- assign sgl = product.variants.last -%}
{%- for v in product.variants -%}{%- if v.title == section.settings.double_variant -%}{%- assign dbl = v -%}{%- endif -%}{%- if v.title == section.settings.single_variant -%}{%- assign sgl = v -%}{%- endif -%}{%- endfor -%}
{%- assign dbl_price = dbl.price | divided_by: 100.0 | round -%}
{%- assign sgl_price = sgl.price | divided_by: 100.0 | round -%}
{%- assign dbl_save = 0 -%}{%- if dbl.compare_at_price > dbl.price -%}{%- assign dbl_save = dbl.compare_at_price | minus: dbl.price | divided_by: 100.0 | round -%}{%- endif -%}
<section class="section reprise">
  <div class="wrap center">
    <h2>امنحي حليبك <span class="hl">طريقة أسهل للخروج</span></h2>
    <div class="offer roffer" role="radiogroup" aria-label="اختاري عرضك"><div class="ocard sel" role="radio" aria-checked="true" tabindex="0" data-name="مضخة مزدوجة" data-price="{{ dbl_price }} ر.س" data-variant-id="{{ dbl.id }}" onclick="pickR(this)"><span class="flag"><svg viewBox="0 0 100 100"><path d="M96.8,60.7 L86.9,67.8 L87.5,79.9 L75.6,82.1 L70.8,93.2 L59.1,90.0 L50.0,98.0 L40.9,90.0 L29.2,93.2 L24.4,82.1 L12.5,79.9 L13.1,67.8 L3.2,60.7 L9.0,50.0 L3.2,39.3 L13.1,32.2 L12.5,20.1 L24.4,17.9 L29.2,6.8 L40.9,10.0 L50.0,2.0 L59.1,10.0 L70.8,6.8 L75.6,17.9 L87.5,20.1 L86.9,32.2 L96.8,39.3 L91.0,50.0 Z" fill="var(--navy)"/></svg><span>الأكثر<br>طلباً</span></span><div class="ohead">
            <span class="oradio"></span>
            <img class="oimg" width="76" height="76" loading="eager" src="{{ 'ww-sa-img-02.png' | asset_url }}" alt="مضخة مزدوجة">
            <div class="otitle"><span class="oname">مضخة مزدوجة</span>{%- if dbl_save > 0 -%}<span class="obadge">وفّري {{ dbl_save }} ر.س</span>{%- endif -%}</div>
            <div class="oprice"><span class="onow">{{ dbl_price }} ر.س</span></div>
          </div><div class="rgifts"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg><span>عدة المقاسات وأكياس الحفظ والشحن مجاناً</span></div></div><div class="ocard" role="radio" aria-checked="false" tabindex="0" data-name="مضخة مفردة" data-price="{{ sgl_price }} ر.س" data-variant-id="{{ sgl.id }}" onclick="pickR(this)"><div class="ohead">
            <span class="oradio"></span>
            <img class="oimg" width="76" height="76" loading="eager" src="{{ 'ww-sa-img-06.png' | asset_url }}" alt="مضخة مفردة">
            <div class="otitle"><span class="oname">مضخة مفردة</span></div>
            <div class="oprice"><span class="onow">{{ sgl_price }} ر.س</span></div>
          </div><div class="rgifts"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg><span>عدة المقاسات وأكياس الحفظ والشحن مجاناً</span></div></div></div>
    <div style="margin-top:24px"><a href="#top" class="btn btn-atc btn-lg" style="max-width:520px;margin:0 auto" onclick="document.getElementById('atc').scrollIntoView({behavior:'smooth',block:'center'});return false;"><span>اطلبيها الآن</span></a></div>
    <div class="rep-summary">
      <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>ضمان 6 أشهر</span>
      <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>عدة المقاسات مجاناً</span>
      <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6L9 17l-5-5"/></svg>شحن مجاني</span>
    </div>
  </div>
</section>
<script>
  var slides=["https://weewonderssa.com/cdn/shop/files/carousel_hero1.jpg", "https://weewonderssa.com/cdn/shop/files/mechanism.jpg", "https://weewonderssa.com/cdn/shop/files/carousel_objection_handling.jpg", "https://weewonderssa.com/cdn/shop/files/product1.png", "https://weewonderssa.com/cdn/shop/files/product3.png"];
  var gi=0, main=document.getElementById('mainimg'), thumbs=document.querySelectorAll('#thumbs button');
  function galSet(i){gi=(i+slides.length)%slides.length;main.src=slides[gi];thumbs.forEach(function(b,k){b.classList.toggle('active',k===gi);});}
  function galStep(d){galSet(gi+d);}
  function pickO(el){
    document.querySelectorAll('#offer .ocard').forEach(function(v){v.classList.remove('sel');v.setAttribute('aria-checked','false');});
    el.classList.add('sel');el.setAttribute('aria-checked','true');
    document.getElementById('barprice').childNodes[0].textContent=el.dataset.price;
    document.getElementById('barname').textContent=el.dataset.name;
  }
  function pick(el){pickO(el);}
  function pickRep(el){
    document.querySelectorAll('.rep-grid .variant').forEach(function(v){v.classList.remove('sel');});
    el.classList.add('sel');
    var main=document.querySelector('#offer .ocard[data-name="'+el.dataset.name+'"]');
    if(main){pickO(main);}
  }
  function addToCart(btn){
    var sel=document.querySelector('#offer .ocard.sel');
    // Shopify: POST /cart/add.js with the selected set's variant id (data-variant-id) before redirecting to /cart
    document.dispatchEvent(new CustomEvent('ww:add-to-cart',{detail:{name:sel.dataset.name,price:sel.dataset.price}}));
    var s=btn.querySelector('span');var old=s.textContent;s.textContent='تمت الإضافة';setTimeout(function(){s.textContent=old;},1400);
  }

  document.querySelectorAll('.dvid .vframe').forEach(function(f){
    var v=f.querySelector('video'),b=f.querySelector('.vplay');
    function toggle(){
      if(v.paused){document.querySelectorAll('.dvid video').forEach(function(o){if(o!==v){o.pause();}});v.play();}else{v.pause();}
    }
    b.addEventListener('click',function(e){e.stopPropagation();toggle();});
    v.addEventListener('click',toggle);
    v.addEventListener('play',function(){f.classList.add('playing');});
    v.addEventListener('pause',function(){f.classList.remove('playing');});
    v.addEventListener('ended',function(){f.classList.remove('playing');});
  });
  var bar=document.getElementById('buybar');
  window.addEventListener('scroll',function(){if(window.scrollY>640){bar.classList.add('show');}else{bar.classList.remove('show');}},{passive:true});

  // milk timeline: drag-to-reveal on desktop, scroll-to-reveal on mobile
  (function(){
    var stations = Array.prototype.slice.call(document.querySelectorAll('#jsteps .js'));
    var n = stations.length;
    if(!n) return;
    var isDesktop = window.matchMedia('(min-width:981px)').matches;

    if(isDesktop){
      var drag = document.getElementById('milkDrag');
      var fill = document.getElementById('milkFill');
      var hint = document.querySelector('.drag-hint');
      var cursor = document.getElementById('milkCursor');
      var cursorSpan = cursor ? cursor.querySelector('span') : null;
      var stationEmoji = ['😌','🎵','📈','🍼','🌱'];
      function applyDrag(val){
        fill.style.width = val + '%';
        if(cursor){
          var size = 30 + (val/100)*24;
          cursor.style.left = 'calc(4% + ' + (val*0.92) + '%)';
          cursor.style.width = size + 'px';
          cursor.style.height = size + 'px';
          cursor.style.top = (40 - size/2) + 'px';
          if(cursorSpan) cursorSpan.style.fontSize = (size*0.5) + 'px';
        }
        var idx = -1;
        stations.forEach(function(el, i){
          var threshold = (i/(n-1))*100 - 2;
          var isActive = val >= threshold;
          el.classList.toggle('active', isActive);
          if(isActive) idx = i;
        });
        if(cursorSpan) cursorSpan.textContent = idx >= 0 ? stationEmoji[idx] : '💧';
      }
      if(drag){
        drag.addEventListener('input', function(){
          applyDrag(parseInt(drag.value,10));
          if(hint) hint.style.opacity = '0';
        });
      }
    } else {
      if('IntersectionObserver' in window){
        var io = new IntersectionObserver(function(entries){
          entries.forEach(function(entry){
            if(entry.isIntersecting){ entry.target.classList.add('active'); }
          });
        }, {threshold:.4, rootMargin:'0px 0px -10% 0px'});
        stations.forEach(function(el){ io.observe(el); });
      } else {
        stations.forEach(function(el){ el.classList.add('active'); });
      }
    }
  })();

  // count-up numbers on scroll into view
  (function(){
    var els = document.querySelectorAll('.cu');
    if(!('IntersectionObserver' in window)){ els.forEach(function(e){e.textContent=e.dataset.target+'%';}); return; }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(!entry.isIntersecting) return;
        var el = entry.target, target = parseInt(el.dataset.target,10), start=null, dur=1100;
        function step(ts){
          if(!start) start=ts;
          var p = Math.min((ts-start)/dur,1);
          var eased = 1 - Math.pow(1-p,3);
          el.textContent = Math.round(eased*target) + '%';
          if(p<1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
        io.unobserve(el);
      });
    },{threshold:.6});
    els.forEach(function(e){io.observe(e);});
  })();
    (function(){
      var refill = document.querySelector('.refill');
      if(!refill) return;
      var lo = refill.querySelector('.drop-ico.small');
      var hi = refill.querySelector('.drop-ico.big');
      var ticking = false;
      function update(){
        var r = refill.getBoundingClientRect();
        var vh = window.innerHeight;
        var start = vh;
        var end = vh * 0.3;
        var progress = (start - r.top) / (start - end);
        progress = Math.max(0, Math.min(1, progress));
        if(lo) lo.style.transform = 'scale(' + (0.6 + progress * 0.5) + ')';
        if(hi) hi.style.transform = 'scale(' + (0.6 + progress * 1.3) + ')';
        ticking = false;
      }
      function onScroll(){
        if(!ticking){
          requestAnimationFrame(update);
          ticking = true;
        }
      }
      window.addEventListener('scroll', onScroll, {passive:true});
      update();
    })();
</script>
</div>
{% schema %}
{
 "name": "WW SA Offer (bottom)",
 "settings": [
  {
   "type": "header",
   "content": "Offer (variants)"
  },
  {
   "type": "text",
   "id": "double_variant",
   "label": "Double pump variant title",
   "default": "Double Pump",
   "info": "Must match the variant title exactly. If not found, the first variant is used."
  },
  {
   "type": "text",
   "id": "single_variant",
   "label": "Single pump variant title",
   "default": "Single Pump",
   "info": "Must match the variant title exactly. If not found, the last variant is used."
  }
 ],
 "presets": [
  {
   "name": "WW SA Offer (bottom)"
  }
 ]
}
{% endschema %}
