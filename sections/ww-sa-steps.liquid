<link rel="stylesheet" href="{{ 'ww-sa-pdp.css' | asset_url }}">
<style>@font-face{font-family:'Cairo';font-style:normal;font-weight:200 1000;font-display:swap;src:url({{ 'ww-sa-cairo-ar.woff2' | asset_url }}) format('woff2');unicode-range:U+0600-06FF,U+0750-077F,U+0870-088E,U+0890-0891,U+0898-08E1,U+08E3-08FF,U+200C-200E,U+2010-2011,U+204F,U+2E41,U+FB50-FDFF,U+FE70-FE74,U+FE76-FEFC}@font-face{font-family:'Cairo';font-style:normal;font-weight:200 1000;font-display:swap;src:url({{ 'ww-sa-cairo-lat.woff2' | asset_url }}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}</style>
<div class="ww-sa" dir="rtl" lang="ar">
<section class="section">
  <div class="wrap">
    <div class="center"><h2>{{ section.settings.heading_prefix }}<span class="hl-solid dfx">{{ section.settings.heading_highlight }}</span></h2></div>
    <div class="steps">
{% if section.blocks.size > 0 %}
{% for block in section.blocks %}
      <div class="step" {{ block.shopify_attributes }}><div class="ph sq"><img src="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 }}{% else %}{%- case forloop.index -%}{% when 1 %}{{ 'ww-sa-img-09.jpg' | asset_url }}{% when 2 %}{{ 'ww-sa-img-03.jpg' | asset_url }}{% when 3 %}{{ 'ww-sa-img-10.jpg' | asset_url }}{% when 4 %}{{ 'ww-sa-img-11.jpg' | asset_url }}{% when 5 %}{{ 'ww-sa-img-12.jpg' | asset_url }}{% else %}{{ 'ww-sa-img-09.jpg' | asset_url }}{% endcase -%}{% endif %}" alt="" loading="lazy"></div><div class="num">{{ forloop.index }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
{% endfor %}
{% else %}
      <div class="step"><div class="ph sq"><img src="{{ 'ww-sa-img-09.jpg' | asset_url }}" alt=""></div><div class="num">1</div><h3>ركّبي القطع</h3><p>ثواني وتصير جاهزة.</p></div>
      <div class="step"><div class="ph sq"><img src="{{ 'ww-sa-img-03.jpg' | asset_url }}" alt=""></div><div class="num">2</div><h3>اختاري مقاسك</h3><p>استخدمي أداة القياس.</p></div>
      <div class="step"><div class="ph sq"><img src="{{ 'ww-sa-img-10.jpg' | asset_url }}" alt=""></div><div class="num">3</div><h3>حطّيها داخل حمالة الصدر</h3><p>خفيفة وما تبيّن.</p></div>
      <div class="step"><div class="ph sq"><img src="{{ 'ww-sa-img-11.jpg' | asset_url }}" alt=""></div><div class="num">4</div><h3>ابدئي</h3><p>اختاري الوضع المريح لك.</p></div>
      <div class="step"><div class="ph sq"><img src="{{ 'ww-sa-img-12.jpg' | asset_url }}" alt=""></div><div class="num">5</div><h3>اسكبي الحليب</h3><p>مباشرة في أكياس الحفظ.</p></div>
{% endif %}
    </div>
  </div>
</section>
</div>
{% schema %}
{
 "name": "WW SA How to use",
 "settings": [
  {"type": "text", "id": "heading_prefix", "label": "Heading (before)", "default": "خمس خطوات، وبعدها "},
  {"type": "text", "id": "heading_highlight", "label": "Heading (highlighted)", "default": "إيديك حرّة"}
 ],
 "blocks": [
  {
   "type": "step",
   "name": "Step",
   "settings": [
    {"type": "image_picker", "id": "image", "label": "Step image", "info": "Leave empty for the default image for this position."},
    {"type": "text", "id": "title", "label": "Title", "default": "الخطوة"},
    {"type": "text", "id": "text", "label": "Short text", "default": "الوصف."}
   ]
  }
 ],
 "max_blocks": 10,
 "presets": [
  {
   "name": "WW SA How to use",
   "blocks": [
    {"type": "step", "settings": {"title": "ركّبي القطع", "text": "ثواني وتصير جاهزة."}},
    {"type": "step", "settings": {"title": "اختاري مقاسك", "text": "استخدمي أداة القياس."}},
    {"type": "step", "settings": {"title": "حطّيها داخل حمالة الصدر", "text": "خفيفة وما تبيّن."}},
    {"type": "step", "settings": {"title": "ابدئي", "text": "اختاري الوضع المريح لك."}},
    {"type": "step", "settings": {"title": "اسكبي الحليب", "text": "مباشرة في أكياس الحفظ."}}
   ]
  }
 ]
}
{% endschema %}
