<link rel="stylesheet" href="{{ 'ww-sa-pdp.css' | asset_url }}">
<style>@font-face{font-family:'Cairo';font-style:normal;font-weight:200 1000;font-display:swap;src:url({{ 'ww-sa-cairo-ar.woff2' | asset_url }}) format('woff2');unicode-range:U+0600-06FF,U+0750-077F,U+0870-088E,U+0890-0891,U+0898-08E1,U+08E3-08FF,U+200C-200E,U+2010-2011,U+204F,U+2E41,U+FB50-FDFF,U+FE70-FE74,U+FE76-FEFC}@font-face{font-family:'Cairo';font-style:normal;font-weight:200 1000;font-display:swap;src:url({{ 'ww-sa-cairo-lat.woff2' | asset_url }}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}</style>
<div class="ww-sa" dir="rtl" lang="ar">
<section class="section" style="background:var(--sky-soft)" id="faq">
  <div class="wrap">
    <div class="center"><h2><span class="hl">{{ section.settings.heading_highlight }}</span>{{ section.settings.heading_suffix }}</h2></div>
    <div class="faq">
{% if section.blocks.size > 0 %}
{% for block in section.blocks %}
      <details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}<span class="pm">+</span></summary><p>{{ block.settings.answer }}</p></details>
{% endfor %}
{% else %}
      <details><summary>أختار مضخة مفردة أو مزدوجة؟<span class="pm">+</span></summary><p>المفردة تضخ جهة وحدة، وهي أخف وأوفر. المزدوجة تضخ الجهتين مع بعض وتختصر وقتك للنصف، ولهذا أغلب الأمهات اللي يضخون كثير يختارونها.</p></details>
      <details><summary>هل تأثر على إدرار الحليب؟<span class="pm">+</span></summary><p>الجسم ينتج الحليب حسب الطلب. لما يكون المقاس مناسب ويكتمل التفريغ، توصل للجسم إشارة أوضح يكمل. كل جسم مختلف والنتائج تختلف من أم لثانية ولا يمكن ضمانها.</p></details>
      <details><summary>كيف أعرف المقاس المناسب؟<span class="pm">+</span></summary><p>في كل علبة 4 مقاسات (17 و19 و21 و24 مم) مع أداة قياس. مو متأكدة؟ أرسلي لنا صورة على واتساب ونساعدك تختارين.</p></details>
      <details><summary>هل هي هادئة وما تبين؟<span class="pm">+</span></summary><p>أقل من 50 ديسيبل وتنحط داخل حمالة الصدر بدون أنابيب أو أسلاك، تختفي تحت لبسك وهادية في أي غرفة عادية.</p></details>
      <details><summary>كم يستغرق التوصيل؟<span class="pm">+</span></summary><p>توصيل سريع لمدن المملكة، ودعم واتساب 7 أيام في الأسبوع.</p></details>
{% endif %}
    </div>
  </div>
</section>
</div>
{% schema %}
{
 "name": "WW SA FAQ",
 "settings": [
  {"type": "text", "id": "heading_highlight", "label": "Heading (highlighted)", "default": "أسئلة"},
  {"type": "text", "id": "heading_suffix", "label": "Heading (after)", "default": " تسألها الأمهات"}
 ],
 "blocks": [
  {
   "type": "faq",
   "name": "Question",
   "settings": [
    {"type": "text", "id": "question", "label": "Question", "default": "سؤال؟"},
    {"type": "textarea", "id": "answer", "label": "Answer", "default": "الإجابة هنا."}
   ]
  }
 ],
 "max_blocks": 20,
 "presets": [
  {
   "name": "WW SA FAQ",
   "blocks": [
    {"type": "faq", "settings": {"question": "أختار مضخة مفردة أو مزدوجة؟", "answer": "المفردة تضخ جهة وحدة، وهي أخف وأوفر. المزدوجة تضخ الجهتين مع بعض وتختصر وقتك للنصف، ولهذا أغلب الأمهات اللي يضخون كثير يختارونها."}},
    {"type": "faq", "settings": {"question": "هل تأثر على إدرار الحليب؟", "answer": "الجسم ينتج الحليب حسب الطلب. لما يكون المقاس مناسب ويكتمل التفريغ، توصل للجسم إشارة أوضح يكمل. كل جسم مختلف والنتائج تختلف من أم لثانية ولا يمكن ضمانها."}},
    {"type": "faq", "settings": {"question": "كيف أعرف المقاس المناسب؟", "answer": "في كل علبة 4 مقاسات (17 و19 و21 و24 مم) مع أداة قياس. مو متأكدة؟ أرسلي لنا صورة على واتساب ونساعدك تختارين."}},
    {"type": "faq", "settings": {"question": "هل هي هادئة وما تبين؟", "answer": "أقل من 50 ديسيبل وتنحط داخل حمالة الصدر بدون أنابيب أو أسلاك، تختفي تحت لبسك وهادية في أي غرفة عادية."}},
    {"type": "faq", "settings": {"question": "كم يستغرق التوصيل؟", "answer": "توصيل سريع لمدن المملكة، ودعم واتساب 7 أيام في الأسبوع."}}
   ]
  }
 ]
}
{% endschema %}
