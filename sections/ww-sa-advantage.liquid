<link rel="stylesheet" href="{{ 'ww-sa-pdp.css' | asset_url }}">
<style>@font-face{font-family:'Cairo';font-style:normal;font-weight:200 1000;font-display:swap;src:url({{ 'ww-sa-cairo-ar.woff2' | asset_url }}) format('woff2');unicode-range:U+0600-06FF,U+0750-077F,U+0870-088E,U+0890-0891,U+0898-08E1,U+08E3-08FF,U+200C-200E,U+2010-2011,U+204F,U+2E41,U+FB50-FDFF,U+FE70-FE74,U+FE76-FEFC}@font-face{font-family:'Cairo';font-style:normal;font-weight:200 1000;font-display:swap;src:url({{ 'ww-sa-cairo-lat.woff2' | asset_url }}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}</style>
<div class="ww-sa" dir="rtl" lang="ar">
<section class="section">
  <div class="wrap adv">
    <div class="float-stage" aria-hidden="true"><svg class="fstar s1" viewBox="-8 -8 116 116" fill="none" aria-hidden="true"><path d="M50 4C54 34 66 46 96 50 66 54 54 66 50 96 46 66 34 54 4 50 34 46 46 34 50 4Z" fill="var(--sky)" transform="translate(-8 9)"/><path d="M50 4C54 34 66 46 96 50 66 54 54 66 50 96 46 66 34 54 4 50 34 46 46 34 50 4Z" stroke="var(--navy)" stroke-width="3" stroke-linejoin="round"/></svg><svg class="fstar s2" viewBox="-8 -8 116 116" fill="none" aria-hidden="true"><path d="M50 4C54 34 66 46 96 50 66 54 54 66 50 96 46 66 34 54 4 50 34 46 46 34 50 4Z" fill="var(--sky)" transform="translate(-8 9)"/><path d="M50 4C54 34 66 46 96 50 66 54 54 66 50 96 46 66 34 54 4 50 34 46 46 34 50 4Z" stroke="var(--navy)" stroke-width="3.6" stroke-linejoin="round"/></svg><svg class="fstar s3" viewBox="-8 -8 116 116" fill="none" aria-hidden="true"><path d="M50 4C54 34 66 46 96 50 66 54 54 66 50 96 46 66 34 54 4 50 34 46 46 34 50 4Z" fill="var(--sky)" transform="translate(-8 9)"/><path d="M50 4C54 34 66 46 96 50 66 54 54 66 50 96 46 66 34 54 4 50 34 46 46 34 50 4Z" stroke="var(--navy)" stroke-width="4" stroke-linejoin="round"/></svg>{% assign fp = section.settings.float_image %}{% if fp != blank %}<img class="fpump" src="{{ fp | image_url: width: 500 }}" alt="">{% else %}<img class="fpump" src="{{ 'ww-sa-img-07.png' | asset_url }}" alt="">{% endif %}<div class="fshadow"></div></div>
    <div>
      <h2>{{ section.settings.heading_prefix }}<span class="hl">{{ section.settings.heading_highlight }}</span>{{ section.settings.heading_suffix }}</h2>
      <div class="adv-list" style="margin-top:22px">
{% if section.blocks.size > 0 %}
{% for block in section.blocks %}
        <div class="adv-item" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<div class="i"><img src="{{ block.settings.image | image_url: width: 160 }}" alt="" width="44" height="44" loading="lazy"></div>{% else %}<div class="i">{%- case forloop.index -%}{% when 1 %}<svg width="44" height="44" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M6 15h30v14H6z" fill="var(--sky)"/><g stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="32" height="15" rx="3"/><path d="M9 11v6M15 11v9M21 11v6M27 11v9"/><path d="M8 33h22M8 33l3-2.4M8 33l3 2.4M30 33l-3-2.4M30 33l-3 2.4" stroke-width="1.7"/></g></svg>{% when 2 %}<svg width="44" height="44" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M5 17h7l8-7v22l-8-7H5z" fill="var(--sky)"/><g stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 14h6l8-7v26l-8-7H7z"/><path d="M26 15a7 7 0 010 10M30 11.5a12 12 0 010 17" /></g></svg>{% when 3 %}<svg width="44" height="44" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M20 7c6 7 10 12 10 18a10 10 0 01-20 0c0-6 4-11 10-18z" fill="var(--sky)"/><g stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 4c6 7 10 12 10 18a10 10 0 01-20 0c0-6 4-11 10-18z"/><path d="M14.5 23l3.5 3.5 7-7"/></g></svg>{% when 4 %}<svg width="44" height="44" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M22 9c7 0 12 6 12 14 0 8-5 14-12 14S10 31 10 23C10 15 15 9 22 9z" fill="var(--sky)"/><g stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 4c7 0 12 6 12 14 0 8-5 14-12 14S7 26 7 18C7 10 12 4 19 4z"/><rect x="14" y="9" width="10" height="2.6" rx="1.3"/><path d="M8.5 22h21M12 28c4 2.4 10 2.4 14 0" stroke-width="1.8"/></g></svg>{%- else -%}<svg width="44" height="44" viewBox="-8 -8 116 116" fill="none" aria-hidden="true"><path d="M50 4C54 34 66 46 96 50 66 54 54 66 50 96 46 66 34 54 4 50 34 46 46 34 50 4Z" fill="var(--sky)" stroke="var(--navy)" stroke-width="4" stroke-linejoin="round"/></svg>{%- endcase -%}</div>{% endif %}<div><b>{{ block.settings.title }}</b><small>{{ block.settings.text }}</small></div></div>
{% endfor %}
{% else %}
        <div class="adv-item"><div class="i"><svg width="44" height="44" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M6 15h30v14H6z" fill="var(--sky)"/><g stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="32" height="15" rx="3"/><path d="M9 11v6M15 11v9M21 11v6M27 11v9"/><path d="M8 33h22M8 33l3-2.4M8 33l3 2.4M30 33l-3-2.4M30 33l-3 2.4" stroke-width="1.7"/></g></svg></div><div><b>مقاسك أنتِ</b><small>تجي مع 4 مقاسات + أداة قياس، فما تحتارين في مقاسك.</small></div></div>
        <div class="adv-item"><div class="i"><svg width="44" height="44" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M5 17h7l8-7v22l-8-7H5z" fill="var(--sky)"/><g stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 14h6l8-7v26l-8-7H7z"/><path d="M26 15a7 7 0 010 10M30 11.5a12 12 0 010 17" /></g></svg></div><div><b>هادئة جداً</b><small>أقل من 50 ديسيبل، ما أحد يحس فيها.</small></div></div>
        <div class="adv-item"><div class="i"><svg width="44" height="44" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M20 7c6 7 10 12 10 18a10 10 0 01-20 0c0-6 4-11 10-18z" fill="var(--sky)"/><g stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 4c6 7 10 12 10 18a10 10 0 01-20 0c0-6 4-11 10-18z"/><path d="M14.5 23l3.5 3.5 7-7"/></g></svg></div><div><b>مانعة للتسرب</b><small>محكمة الإغلاق حتى لو انقلبت.</small></div></div>
        <div class="adv-item"><div class="i"><svg width="44" height="44" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M22 9c7 0 12 6 12 14 0 8-5 14-12 14S10 31 10 23C10 15 15 9 22 9z" fill="var(--sky)"/><g stroke="var(--navy)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 4c7 0 12 6 12 14 0 8-5 14-12 14S7 26 7 18C7 10 12 4 19 4z"/><rect x="14" y="9" width="10" height="2.6" rx="1.3"/><path d="M8.5 22h21M12 28c4 2.4 10 2.4 14 0" stroke-width="1.8"/></g></svg></div><div><b>حرة اليدين فعلاً</b><small>البسيها وسوّي أي شي ثاني.</small></div></div>
{% endif %}
      </div>
    </div>
  </div>
</section>
</div>
{% schema %}
{
 "name": "WW SA Advantage",
 "settings": [
  {"type": "text", "id": "heading_prefix", "label": "Heading (before)", "default": "وش اللي "},
  {"type": "text", "id": "heading_highlight", "label": "Heading (highlighted)", "default": "يميّز"},
  {"type": "text", "id": "heading_suffix", "label": "Heading (after)", "default": " هذي المضخة؟"},
  {"type": "image_picker", "id": "float_image", "label": "Floating product image", "info": "Decorative image on the side. Leave empty for the default."}
 ],
 "blocks": [
  {
   "type": "item",
   "name": "Advantage",
   "settings": [
    {"type": "text", "id": "title", "label": "Title", "default": "عنوان الميزة"},
    {"type": "textarea", "id": "text", "label": "Description", "default": "اكتب وصف الميزة هنا."},
    {"type": "image_picker", "id": "image", "label": "Custom icon (optional)", "info": "Leave empty to use the built-in icon for this position."}
   ]
  }
 ],
 "max_blocks": 10,
 "presets": [
  {
   "name": "WW SA Advantage",
   "blocks": [
    {"type": "item", "settings": {"title": "مقاسك أنتِ", "text": "تجي مع 4 مقاسات + أداة قياس، فما تحتارين في مقاسك."}},
    {"type": "item", "settings": {"title": "هادئة جداً", "text": "أقل من 50 ديسيبل، ما أحد يحس فيها."}},
    {"type": "item", "settings": {"title": "مانعة للتسرب", "text": "محكمة الإغلاق حتى لو انقلبت."}},
    {"type": "item", "settings": {"title": "حرة اليدين فعلاً", "text": "البسيها وسوّي أي شي ثاني."}}
   ]
  }
 ]
}
{% endschema %}
