<link rel="stylesheet" href="{{ 'ww-sa-pdp.css' | asset_url }}">
<style>@font-face{font-family:'Cairo';font-style:normal;font-weight:200 1000;font-display:swap;src:url({{ 'ww-sa-cairo-ar.woff2' | asset_url }}) format('woff2');unicode-range:U+0600-06FF,U+0750-077F,U+0870-088E,U+0890-0891,U+0898-08E1,U+08E3-08FF,U+200C-200E,U+2010-2011,U+204F,U+2E41,U+FB50-FDFF,U+FE70-FE74,U+FE76-FEFC}@font-face{font-family:'Cairo';font-style:normal;font-weight:200 1000;font-display:swap;src:url({{ 'ww-sa-cairo-lat.woff2' | asset_url }}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}</style>
<div class="ww-sa" dir="rtl" lang="ar">
<section class="section doctor-videos" id="doctors">
  <div class="wrap">
    <div class="center">
      <h2>{{ section.settings.heading_prefix | default: 'اسمعيها من أمهات وطبيبات' }} {% if section.settings.heading_highlight != blank %}<span class="hl">{{ section.settings.heading_highlight }}</span>{% endif %}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="sub" style="color:var(--muted);margin-top:8px;font-size:1.05rem;">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    <div class="vids">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign video_url = '' -%}
          {%- if block.settings.video != blank -%}
            {%- for s in block.settings.video.sources -%}
              {%- if s.format == 'mp4' -%}
                {%- assign video_url = s.url -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if video_url == blank and block.settings.video.sources.size > 0 -%}
              {%- assign video_url = block.settings.video.sources[0].url -%}
            {%- endif -%}
          {%- elsif block.settings.video_url != blank -%}
            {%- assign video_url = block.settings.video_url -%}
          {%- endif -%}

          {%- assign poster_url = '' -%}
          {%- if block.settings.cover_image != blank -%}
            {%- assign poster_url = block.settings.cover_image | image_url: width: 800 -%}
          {%- elsif block.settings.poster_url != blank -%}
            {%- assign poster_url = block.settings.poster_url -%}
          {%- elsif block.settings.video != blank and block.settings.video.preview_image != blank -%}
            {%- assign poster_url = block.settings.video.preview_image | image_url: width: 800 -%}
          {%- endif -%}

          {%- assign author_name = block.settings.author | default: 'أم من WeeWonders' -%}
          <figure class="vid dvid" {{ block.shopify_attributes }}>
            <div class="vframe">
              {%- if video_url != blank -%}
                <video preload="none" playsinline poster="{{ poster_url }}" src="{{ video_url }}" aria-label="{{ author_name | escape }}"></video>
                <button class="vplay" type="button" aria-label="شغّلي الفيديو: {{ author_name | escape }}"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button>
              {%- elsif poster_url != blank -%}
                <img src="{{ poster_url }}" alt="{{ author_name | escape }}" style="width:100%;height:100%;object-fit:cover;display:block;">
              {%- endif -%}
            </div>
            <figcaption class="cap">
              {%- if block.settings.tag != blank -%}<span class="pain">{{ block.settings.tag }}</span>{%- endif -%}
              <b>{{ author_name }}</b>
              {%- if block.settings.stars != blank -%}<span class="stars">{{ block.settings.stars }}</span>{%- endif -%}
            </figcaption>
          </figure>
        {%- endfor -%}
      {%- else -%}
        <figure class="vid dvid"><div class="vframe"><video preload="none" playsinline poster="https://weewonderssa.com/cdn/shop/files/preview_images/357122ab183d4474973f358529c201ae.thumbnail.0000000000_700x.jpg" src="https://cdn.shopify.com/videos/c/vp/357122ab183d4474973f358529c201ae/357122ab183d4474973f358529c201ae.HD-720p-1.6Mbps-67072483.mp4" aria-label="د. إيليت سخن"></video><button class="vplay" type="button" aria-label="شغّلي الفيديو: د. إيليت سخن"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div><figcaption class="cap"><span class="pain">الرضاعة والعمل</span><b>د. إيليت سخن</b><span class="stars">★★★★★</span></figcaption></figure>
        <figure class="vid dvid"><div class="vframe"><video preload="none" playsinline poster="https://weewonderssa.com/cdn/shop/files/preview_images/178cd5038c8c4173b650d27296215520.thumbnail.0000000000_700x.jpg" src="https://cdn.shopify.com/videos/c/vp/178cd5038c8c4173b650d27296215520/178cd5038c8c4173b650d27296215520.HD-720p-4.5Mbps-71120658.mp4" aria-label="نورة"></video><button class="vplay" type="button" aria-label="شغّلي الفيديو: نورة"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div><figcaption class="cap"><span class="pain">تجربة أم</span><b>نورة</b><span class="stars">★★★★★</span></figcaption></figure>
        <figure class="vid dvid"><div class="vframe"><video preload="none" playsinline poster="https://weewonderssa.com/cdn/shop/files/preview_images/f464929baf6f4962884362467b21dd5c.thumbnail.0000000000_700x.jpg" src="https://cdn.shopify.com/videos/c/vp/f464929baf6f4962884362467b21dd5c/f464929baf6f4962884362467b21dd5c.HD-720p-4.5Mbps-71126738.mp4" aria-label="مها"></video><button class="vplay" type="button" aria-label="شغّلي الفيديو: مها"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div><figcaption class="cap"><span class="pain">تجربتها مع الشفاط</span><b>مها</b><span class="stars">★★★★★</span></figcaption></figure>
        <figure class="vid dvid"><div class="vframe"><video preload="none" playsinline poster="https://weewonderssa.com/cdn/shop/files/preview_images/4b59e0403d9847caa53dc8e2f5681be2.thumbnail.0000000000_700x.jpg" src="https://cdn.shopify.com/videos/c/vp/4b59e0403d9847caa53dc8e2f5681be2/4b59e0403d9847caa53dc8e2f5681be2.HD-720p-4.5Mbps-71121180.mp4" aria-label="أم جديدة"></video><button class="vplay" type="button" aria-label="شغّلي الفيديو: أم جديدة"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div><figcaption class="cap"><span class="pain">تجربة رضاعة</span><b>أم جديدة</b><span class="stars">★★★★★</span></figcaption></figure>
        <figure class="vid dvid"><div class="vframe"><video preload="none" playsinline poster="https://weewonderssa.com/cdn/shop/files/preview_images/316f29ab16b841059ea27a1f0413b3d8.thumbnail.0000000000_700x.jpg" src="https://cdn.shopify.com/videos/c/vp/316f29ab16b841059ea27a1f0413b3d8/316f29ab16b841059ea27a1f0413b3d8.HD-720p-4.5Mbps-71128905.mp4" aria-label="جنى"></video><button class="vplay" type="button" aria-label="شغّلي الفيديو: جنى"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button></div><figcaption class="cap"><span class="pain">تجربة أم</span><b>جنى</b><span class="stars">★★★★★</span></figcaption></figure>
      {%- endif -%}
    </div>
  </div>
</section>
</div>
<script>
(function(){
  function initDocVideos(root){
    var scope = root || document;
    scope.querySelectorAll('.dvid .vframe').forEach(function(f){
      if(f.dataset.vidInit) return;
      f.dataset.vidInit = 'true';
      var v = f.querySelector('video'), b = f.querySelector('.vplay');
      if(!v) return;
      function toggle(e){
        if(e) e.stopPropagation();
        if(v.paused){
          document.querySelectorAll('.dvid video').forEach(function(o){
            if(o !== v){
              o.pause();
              var p = o.closest('.vframe');
              if(p) p.classList.remove('playing');
            }
          });
          v.play();
          f.classList.add('playing');
        } else {
          v.pause();
          f.classList.remove('playing');
        }
      }
      if(b) b.addEventListener('click', toggle);
      f.addEventListener('click', function(e){
        if(e.target === v || e.target === b || (b && b.contains(e.target))){
          toggle(e);
        }
      });
      v.addEventListener('ended', function(){ f.classList.remove('playing'); });
      v.addEventListener('pause', function(){ f.classList.remove('playing'); });
      v.addEventListener('play', function(){ f.classList.add('playing'); });
    });
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', function(){ initDocVideos(); });
  } else {
    initDocVideos();
  }

  document.addEventListener('shopify:section:load', function(e){
    if(e.target && (e.target.id === 'shopify-section-{{ section.id }}' || e.target.querySelector('#doctors'))){
      initDocVideos(e.target);
    }
  });
})();
</script>
