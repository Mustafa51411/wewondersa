<link rel="stylesheet" href="{{ 'ww-pdp.css' | asset_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<div class="ww-pdp">
<section class="section reprise"><div class="wrap center">
<h2>{{ section.settings.h_a }} <span class="hl">{{ section.settings.h_b }}</span></h2>
<div class="offer roffer" role="radiogroup" aria-label="اختاري طقمك">
{%- assign oi = 0 -%}
{%- for b in section.blocks -%}
 {%- assign ov = nil -%}
 {%- for v in product.variants -%}{%- if v.title == b.settings.variant_title -%}{%- assign ov = v -%}{%- break -%}{%- endif -%}{%- endfor -%}
 {%- if ov == nil -%}
   {%- assign b_title_lower = b.settings.variant_title | downcase -%}
   {%- for v in product.variants -%}
     {%- assign v_title_lower = v.title | downcase -%}
     {%- if b_title_lower contains 'double' and v_title_lower contains 'double' -%}
       {%- assign ov = v -%}{%- break -%}
     {%- elsif b_title_lower contains 'single' and v_title_lower contains 'single' -%}
       {%- assign ov = v -%}{%- break -%}
     {%- endif -%}
   {%- endfor -%}
 {%- endif -%}
 {%- if ov == nil and product.variants.size > oi -%}{%- assign ov = product.variants[oi] -%}{%- endif -%}
 {%- if ov == nil -%}{%- assign ov = product.variants.first -%}{%- endif -%}
 <div class="ocard{% if oi == 0 %} sel{% endif %}" role="radio" aria-checked="{% if oi == 0 %}true{% else %}false{% endif %}" tabindex="0" data-name="{{ b.settings.name | escape }}" data-price="{{ ov.price | money_without_trailing_zeros }}" onclick="pickR(this)" {{ b.shopify_attributes }}>
 {%- if b.settings.flag != blank -%}<span class="flag"><svg viewBox="0 0 100 100"><path d="M96.8,60.7 L86.9,67.8 L87.5,79.9 L75.6,82.1 L70.8,93.2 L59.1,90.0 L50.0,98.0 L40.9,90.0 L29.2,93.2 L24.4,82.1 L12.5,79.9 L13.1,67.8 L3.2,60.7 L9.0,50.0 L3.2,39.3 L13.1,32.2 L12.5,20.1 L24.4,17.9 L29.2,6.8 L40.9,10.0 L50.0,2.0 L59.1,10.0 L70.8,6.8 L75.6,17.9 L87.5,20.1 L86.9,32.2 L96.8,39.3 L91.0,50.0 Z" fill="var(--navy)"/></svg><span>{{ b.settings.flag | replace: ' ', '<br>' }}</span></span>{%- endif -%}
 {%- assign offer_image = b.settings.image | default: ov.featured_image | default: product.featured_image -%}<div class="ohead"><span class="oradio"></span>{%- if offer_image != blank -%}<img class="oimg" width="76" height="76" loading="lazy" src="{{ offer_image | image_url: width: 200 }}" alt="{{ b.settings.name | escape }}">{%- endif -%}<div class="otitle"><span class="oname">{{ b.settings.name }}</span><span class="obadge">{{ b.settings.badge }}</span></div><div class="oprice"><span class="onow">{{ ov.price | money_without_trailing_zeros }}</span><span class="owas">{{ b.settings.was_price }}</span></div></div>
 <div class="rgifts"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg><span>{{ b.settings.summary }}</span></div></div>
 {%- assign oi = oi | plus: 1 -%}
{%- endfor -%}
{%- if section.blocks.size == 0 -%}
  {%- for ov in product.variants limit: 2 -%}
    {%- assign offer_image = ov.featured_image | default: product.featured_image -%}
    <div class="ocard{% if forloop.first %} sel{% endif %}" role="radio" aria-checked="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="0" data-name="{{ ov.title | escape }}" data-price="{{ ov.price | money_without_trailing_zeros }}" onclick="pickR(this)">
      <div class="ohead"><span class="oradio"></span>{%- if offer_image != blank -%}<img class="oimg" width="76" height="76" loading="lazy" src="{{ offer_image | image_url: width: 200 }}" alt="{{ ov.title | escape }}">{%- endif -%}<div class="otitle"><span class="oname">{{ ov.title }}</span><span class="obadge">{{ section.settings.default_badge }}</span></div><div class="oprice"><span class="onow">{{ ov.price | money_without_trailing_zeros }}</span></div></div>
      <div class="rgifts"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg><span>{{ section.settings.default_summary }}</span></div>
    </div>
  {%- endfor -%}
{%- endif -%}
</div>
<div style="margin-top:24px"><a href="#ww-top" class="btn btn-atc btn-lg" style="max-width:520px;margin:0 auto" onclick="var a=document.getElementById('atc');if(a){a.scrollIntoView({behavior:'smooth',block:'center'});return false;}"><span>{{ section.settings.button }}</span></a></div>
<div class="rep-summary">
{%- for i in (1..3) -%}{%- assign k = 'chip_' | append: i -%}{%- if section.settings[k] != blank -%}<span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>{{ section.settings[k] }}</span>{%- endif -%}{%- endfor -%}
</div></div></section>
<script>
function pickR(el){document.querySelectorAll('.roffer .ocard').forEach(function(v){v.classList.remove('sel');v.setAttribute('aria-checked','false');});el.classList.add('sel');el.setAttribute('aria-checked','true');
var m=document.querySelector('#offer .ocard[data-name="'+el.dataset.name+'"]');if(m&&window.pickO)window.pickO(m);}
document.querySelectorAll('.roffer .ocard').forEach(function(c){c.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();pickR(c); } });});
</script>
</div>
{% schema %}
{
 "name": "WW Bottom offer",
 "settings": [
  {
   "type": "text",
   "id": "h_a",
   "label": "Heading (plain part)",
   "default": "Give your milk"
  },
  {
   "type": "text",
   "id": "h_b",
   "label": "Heading (marker)",
   "default": "a way out"
  },
  {
   "type": "text",
   "id": "button",
   "label": "Button label",
   "default": "Order yours now"
  },
  {
   "type": "text",
   "id": "default_badge",
   "label": "Fallback offer badge",
   "default": "Free gifts included"
  },
  {
   "type": "text",
   "id": "default_summary",
   "label": "Fallback offer summary",
   "default": "Free sizing kit, gifts and delivery"
  },
  {
   "type": "text",
   "id": "chip_1",
   "label": "Check 1",
   "default": "6-month warranty"
  },
  {
   "type": "text",
   "id": "chip_2",
   "label": "Check 2",
   "default": "Free sizing kit"
  },
  {
   "type": "text",
   "id": "chip_3",
   "label": "Check 3",
   "default": "48h delivery"
  }
 ],
 "blocks": [
  {
   "type": "offer",
   "name": "Offer card",
   "settings": [
    {
     "type": "text",
     "id": "variant_title",
     "label": "Variant title (must match the product option exactly)",
     "default": "Double Pump Set"
    },
    {
     "type": "text",
     "id": "name",
     "label": "Name",
     "default": "Double Pump Set"
    },
    {
     "type": "text",
     "id": "flag",
     "label": "Flag (empty for none)",
     "default": "Most popular"
    },
    {
     "type": "text",
     "id": "badge",
     "label": "Savings badge",
     "default": "Save $50"
    },
    {
     "type": "text",
     "id": "was_price",
     "label": "Crossed-out price",
     "default": "$220"
    },
    {
     "type": "image_picker",
     "id": "image",
     "label": "Offer photo"
    },
    {
     "type": "textarea",
     "id": "summary",
     "label": "Included line",
     "default": "Free sizing kit, storage bags, bottle warmer and delivery"
    }
   ]
  }
 ],
 "presets": [
  {
   "name": "WW Bottom offer"
  }
 ]
}
{% endschema %}
