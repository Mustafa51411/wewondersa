{% doc %}
  @prompt
    Create a section that displays multiple images next to each other in a row. The section should allow merchants to add multiple images that appear side by side horizontally, with options to control spacing and alignment., can you put them all next to each other and potentially make a slider?, and make the edges rounded
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-slider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-image-slider-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
  }

  .ai-image-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.slider_border_radius }}px;
  }

  .ai-image-slider-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.image_spacing }}px;
    transition: transform 0.5s ease;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-image-slider-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-image-slider-item-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: {{ block.settings.slide_width }}%;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-slider-item-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    {% if block.settings.image_height_type == 'fixed' %}
      height: {{ block.settings.fixed_image_height }}px;
    {% endif %}
  }

  .ai-image-slider-placeholder-{{ ai_gen_id }} {
    width: 100%;
    {% if block.settings.image_height_type == 'fixed' %}
      height: {{ block.settings.fixed_image_height }}px;
    {% else %}
      height: 400px;
    {% endif %}
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-slider-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  .ai-image-slider-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 13px;
    color: #666;
    text-align: center;
    pointer-events: none;
    white-space: nowrap;
  }

  .ai-image-slider-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_bg }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: opacity 0.3s ease, background-color 0.3s ease;
    opacity: 0.9;
  }

  .ai-image-slider-nav-{{ ai_gen_id }}:hover {
    opacity: 1;
    background-color: {{ block.settings.nav_button_hover_bg }};
  }

  .ai-image-slider-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-image-slider-nav-prev-{{ ai_gen_id }} {
    left: 10px;
  }

  .ai-image-slider-nav-next-{{ ai_gen_id }} {
    right: 10px;
  }

  .ai-image-slider-nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-image-slider-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .ai-image-slider-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    opacity: 0.4;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-image-slider-dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.2);
  }

  @media screen and (max-width: 749px) {
    .ai-image-slider-item-{{ ai_gen_id }} {
      width: {{ block.settings.slide_width_mobile }}%;
    }

    .ai-image-slider-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 0 {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-image-slider-nav-{{ ai_gen_id }} {
      width: 36px;
      height: 36px;
    }

    .ai-image-slider-nav-{{ ai_gen_id }} svg {
      width: 16px;
      height: 16px;
    }
  }
{% endstyle %}

<image-slider-{{ ai_gen_id }} class="ai-image-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-slider-container-{{ ai_gen_id }}">
    <div class="ai-image-slider-wrapper-{{ ai_gen_id }}">
      {% if block.settings.show_navigation %}
        <button class="ai-image-slider-nav-{{ ai_gen_id }} ai-image-slider-nav-prev-{{ ai_gen_id }}" aria-label="Previous slide">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="ai-image-slider-nav-{{ ai_gen_id }} ai-image-slider-nav-next-{{ ai_gen_id }}" aria-label="Next slide">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {% endif %}

      <div class="ai-image-slider-track-{{ ai_gen_id }}">
        {% assign has_images = false %}
        {% for i in (1..8) %}
          {% assign image_key = 'image_' | append: i %}
          {% assign image = block.settings[image_key] %}
          
          {% if image != blank %}
            {% assign has_images = true %}
            <div class="ai-image-slider-item-{{ ai_gen_id }}">
              <img
                src="{{ image | image_url: width: 1200 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            </div>
          {% endif %}
        {% endfor %}

        {% if has_images == false %}
          <div class="ai-image-slider-item-{{ ai_gen_id }}">
            <div class="ai-image-slider-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-image-slider-empty-state-{{ ai_gen_id }}">
                Add images below
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    {% if block.settings.show_dots %}
      <div class="ai-image-slider-dots-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</image-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-image-slider-track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-image-slider-item-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-image-slider-nav-prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-image-slider-nav-next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-image-slider-dots-{{ ai_gen_id }}');

        if (this.slides.length === 0) return;

        this.initializeDots();
        this.setupEventListeners();
        this.updateSlider();

        {% if block.settings.autoplay %}
          this.startAutoplay();
        {% endif %}
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }

      initializeDots() {
        if (!this.dotsContainer) return;

        this.dotsContainer.innerHTML = '';
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.classList.add('ai-image-slider-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
          if (index === 0) dot.classList.add('active');
          dot.addEventListener('click', () => this.goToSlide(index));
          this.dotsContainer.appendChild(dot);
        });
        this.dots = this.querySelectorAll('.ai-image-slider-dot-{{ ai_gen_id }}');
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.previousSlide());
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextSlide());
        }

        let startX = 0;
        let currentX = 0;
        let isDragging = false;

        this.track.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
          this.stopAutoplay();
        });

        this.track.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          currentX = e.touches[0].clientX;
        });

        this.track.addEventListener('touchend', () => {
          if (!isDragging) return;
          isDragging = false;
          const diff = startX - currentX;
          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              this.nextSlide();
            } else {
              this.previousSlide();
            }
          }
          {% if block.settings.autoplay %}
            this.startAutoplay();
          {% endif %}
        });
      }

      updateSlider() {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = {{ block.settings.image_spacing }};
        const offset = -(this.currentIndex * (slideWidth + gap));
        this.track.style.transform = `translateX(${offset}px)`;

        if (this.dots) {
          this.dots.forEach((dot, index) => {
            dot.classList.toggle('active', index === this.currentIndex);
          });
        }

        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }
        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex === this.slides.length - 1;
        }
      }

      goToSlide(index) {
        this.currentIndex = Math.max(0, Math.min(index, this.slides.length - 1));
        this.updateSlider();
        this.stopAutoplay();
        {% if block.settings.autoplay %}
          this.startAutoplay();
        {% endif %}
      }

      nextSlide() {
        if (this.currentIndex < this.slides.length - 1) {
          this.currentIndex++;
        } else if ({{ block.settings.loop | json }}) {
          this.currentIndex = 0;
        }
        this.updateSlider();
      }

      previousSlide() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
        } else if ({{ block.settings.loop | json }}) {
          this.currentIndex = this.slides.length - 1;
        }
        this.updateSlider();
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, {{ block.settings.autoplay_speed }} * 1000);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }
    }

    customElements.define('image-slider-{{ ai_gen_id }}', ImageSlider{{ ai_gen_id }});
  })();
</script>

